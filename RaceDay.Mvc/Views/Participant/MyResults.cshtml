@model IReadOnlyList<RaceDay.Mvc.Models.ParticipantResultRowViewModel>
@{ ViewData["Title"] = "My results"; }
<p class="eyebrow">PARTICIPANT</p><h1>My results</h1><p class="muted">Your recorded results from completed event entries.</p>
@if (ViewBag.Error is string error) { <div class="alert alert-danger">@error</div> }
@if (Model.Count == 0) { <div class="empty-card">No results have been recorded for your entries yet.</div> }
else { <div class="table-responsive"><table class="table align-middle bg-white"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Result</th></tr></thead><tbody>
@foreach (var row in Model) { <tr><td>@(row.Event?.Name ?? "Event")</td><td>@(row.Event?.Date.ToString("dd MMM yyyy") ?? "—")</td><td>@row.CategoryName</td><td>@(row.Result.FinishTime?.ToString() ?? "—") min</td><td>@(row.Result.Position ?? "—")</td><td>@row.Result.ResultStatus</td></tr> }
</tbody></table></div> }
