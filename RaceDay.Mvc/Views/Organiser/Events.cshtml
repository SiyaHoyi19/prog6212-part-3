@model IReadOnlyList<RaceDay.Contracts.EventDto>
@{ ViewData["Title"] = "Manage events"; }
<div class="section-heading">
 <div><p class="eyebrow">ORGANISER</p><h1>Manage events</h1><p class="muted">Create, update, and remove your own events.</p></div>
 <a asp-action="CreateEvent" class="btn btn-primary">Create event</a>
</div>
@if (ViewBag.Error is string error) { <div class="alert alert-danger">@error</div> }
@if (ViewBag.Success is string success) { <div class="alert alert-success">@success</div> }
@if (Model.Count == 0)
{
 <div class="empty-card">No events yet. Create an event to begin.</div>
}
else
{
 <div class="row g-3">
 @foreach (var ev in Model)
 {
  <div class="col-lg-6">
   <article class="event-card">
    <span class="event-type">@ev.Type · @ev.Distance km</span>
    @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl)) { <img src="@Url.Action("EventBanner", "Media", new { id = ev.EventId })" alt="Banner for @ev.Name" class="img-fluid rounded mt-2" /> }
    <h2 class="h4 mt-3">@ev.Name</h2>
    <p>@ev.Date.ToString("dd MMM yyyy") · @ev.Location</p>
    <p>@ev.Description</p>
    <div class="d-flex flex-wrap gap-2">
     <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-outline-primary btn-sm">Edit</a>
     <a asp-action="Categories" asp-route-eventId="@ev.EventId" class="btn btn-outline-primary btn-sm">Categories</a>
     <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-outline-primary btn-sm">Enrolments</a>
     <a asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-outline-primary btn-sm">Results</a>
     <form asp-action="DeleteEvent" method="post" onsubmit="return confirm('Delete this event? The API may reject deletion if it has enrolments.');">
      <input type="hidden" name="id" value="@ev.EventId" /><button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
     </form>
    </div>
   </article>
  </div>
 }
 </div>
}
