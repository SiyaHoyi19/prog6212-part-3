@model RaceDay.Mvc.Models.RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<div class="auth-card">
    <p class="eyebrow">JOIN RACEDAY</p><h1>Create your account</h1>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span>
        <label asp-for="Email" class="form-label mt-2"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span>
        <label asp-for="Password" class="form-label mt-2"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span>
        <label asp-for="PhoneNumber" class="form-label mt-2"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger"></span>
        <label asp-for="DateOfBirth" class="form-label mt-2"></label><input asp-for="DateOfBirth" class="form-control" /><span asp-validation-for="DateOfBirth" class="text-danger"></span>
        <label asp-for="Role" class="form-label mt-2"></label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organiser</option></select>
        <label asp-for="Username" class="form-label mt-2"></label><input asp-for="Username" class="form-control" /><span asp-validation-for="Username" class="text-danger"></span>
        <button class="btn btn-primary w-100 mt-4" type="submit">Create account</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
