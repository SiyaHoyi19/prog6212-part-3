<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <title>@ViewData["Title"] - RaceDay</title>
 <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
 <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark race-nav">
 <div class="container">
  <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#raceNav" aria-controls="raceNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="raceNav"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
  @if (Context.Session.GetInt32("UserId") is null) {
   <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Sign in</a></li>
   <li class="nav-item"><a class="btn btn-warning btn-sm fw-semibold" asp-controller="Auth" asp-action="Register">Register</a></li>
  } else if (string.Equals(Context.Session.GetString("Role"), "Organiser", StringComparison.OrdinalIgnoreCase)) {
   <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li>
   <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Events</a></li>
   <li class="nav-item"><span class="nav-link text-white-50">@Context.Session.GetString("FullName")</span></li>
   <li class="nav-item"><form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Sign out</button></form></li>
  } else {
   <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Index">Events</a></li>
   <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a></li>
   <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
   <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
   <li class="nav-item"><span class="nav-link text-white-50">@Context.Session.GetString("FullName")</span></li>
   <li class="nav-item"><form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Sign out</button></form></li>
  }
  </ul></div>
 </div>
</nav>
<main class="container py-4 py-lg-5">@RenderBody()</main>
<footer class="container py-4 text-center text-muted small">RaceDay · Move together, go further.</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script><script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
	<span aria-hidden="true">🏁</span>
	<strong>RaceDay</strong>aa
@await RenderSectionAsync("Scripts", required: false)
</body></html>
